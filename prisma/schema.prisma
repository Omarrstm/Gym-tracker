// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  MALE
  FEMALE
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  password         String
  createdAt        DateTime  @default(now())
  heightCm         Float?
  weightKg         Float?
  dateOfBirth      DateTime?
  sex              Sex?
  restTimerSeconds Int       @default(90)

  workoutLogs        WorkoutLog[]
  programs           Program[]
  sessions           Session[]
  bodyWeightLogs     BodyWeightLog[]
  passwordResetTokens PasswordResetToken[]
  customExercises    Exercise[]

  coachProfile      CoachProfile?
  coachOfLinks      CoachAthlete[] @relation("CoachOfLink")
  athleteOfLinks    CoachAthlete[] @relation("AthleteOfLink")
  sentCoachInvites  CoachInvite[]  @relation("SentCoachInvites")
  sentMessages      Message[]      @relation("SentMessages")
  assignedPrograms  Program[]      @relation("CoachAssignedPrograms")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BodyWeightLog {
  id        String   @id @default(cuid())
  weightKg  Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  ARMS
  LEGS
  CORE
  FULL_BODY
}

model Exercise {
  id          String      @id @default(cuid())
  name        String      @unique
  muscleGroup MuscleGroup
  imageUrl    String?
  description String?
  createdAt   DateTime    @default(now())

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  workoutLogs      WorkoutLog[]
  programExercises ProgramExercise[]
}

model WorkoutLog {
  id        String   @id @default(cuid())
  weight    Float
  sets      Int
  reps      Int
  rir       Int?
  notes     String?
  isWarmup  Boolean  @default(false)
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Program {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedByCoachId String?
  assignedByCoach   User?   @relation("CoachAssignedPrograms", fields: [assignedByCoachId], references: [id], onDelete: SetNull)

  days ProgramDay[]
}

model ProgramDay {
  id        String    @id @default(cuid())
  dayOfWeek DayOfWeek
  label     String?
  notes     String?

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  exercises ProgramExercise[]

  @@unique([programId, dayOfWeek])
}

model ProgramExercise {
  id            String @id @default(cuid())
  order         Int
  targetWeight  Float?
  targetSets    Int?
  targetReps    Int?

  programDayId String
  programDay   ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

enum CoachLinkStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum CoachLinkSource {
  EMAIL_INVITE
  JOIN_CODE
  DIRECTORY_REQUEST
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum CoachSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model CoachProfile {
  id          String   @id @default(cuid())
  bio         String?
  specialties String[] @default([])
  joinCode    String   @unique
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptionStatus CoachSubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  experiences CoachExperience[]
}

model CoachExperience {
  id           String  @id @default(cuid())
  title        String
  organization String?
  startYear    Int?
  endYear      Int?
  description  String?
  order        Int     @default(0)

  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)

  @@index([coachProfileId])
}

model CoachAthlete {
  id          String          @id @default(cuid())
  status      CoachLinkStatus @default(PENDING)
  source      CoachLinkSource
  createdAt   DateTime        @default(now())
  respondedAt DateTime?

  coachId   String
  coach     User   @relation("CoachOfLink", fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User   @relation("AthleteOfLink", fields: [athleteId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([coachId, athleteId])
  @@index([coachId, status])
  @@index([athleteId, status])
}

model CoachInvite {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  email      String
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  acceptedAt DateTime?

  coachId String
  coach   User   @relation("SentCoachInvites", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([email])
}

model Message {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  coachAthleteId String
  coachAthlete   CoachAthlete @relation(fields: [coachAthleteId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([coachAthleteId, createdAt])
}
